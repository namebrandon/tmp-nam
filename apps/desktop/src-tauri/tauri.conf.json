{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMP NAM",
  "version": "../package.json",
  "identifier": "dev.tmpnam.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1431",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TMP NAM",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "NAM captures, Tone3000 sync and SD-card builder for the Tone Master Pro.",
    "copyright": "Copyright (c) 2026 Pedro Cavadas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../device/": "device/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
