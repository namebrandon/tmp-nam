+inline void PackDense8x8Rhs(const float* input, const int frames, const std::ptrdiff_t outer_stride, float* packed)
+{
+  for (int depth = 0; depth < DENSE8X8_DEPTH; ++depth)
+    for (int frame = 0; frame < frames; ++frame)
+      packed[depth * frames + frame] = input[frame * outer_stride + depth];
