+
+inline void AddDense8x8Output(float* output, const float32x4_t low, const float32x4_t high)
+{
+  const float32x4_t one = vdupq_n_f32(1.0f);
+  vst1q_f32(output, vfmaq_f32(vld1q_f32(output), low, one));
+  vst1q_f32(output + 4, vfmaq_f32(vld1q_f32(output + 4), high, one));
+}
+
+__attribute__((noinline)) void ComputeDense8x8Packed(const float* weights, const float* packed, const int frames,
+                                                     float* output)
+{
