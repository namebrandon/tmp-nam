+  float32x4_t lh = vaddq_f32(vld1q_f32(lin + 4), vld1q_f32(l1x1_b + 4));
+  NAM_A2_GEMV8(l1x1_w, al, ah, ll, lh);
+  vst1q_f32(lin, ll);
+  vst1q_f32(lin + 4, lh);
+}
+
+void layer8_neon(const float* hist, const int* tap_base, const int num_taps, const float* conv_w, const float* conv_b,
+                 const float* mixin_w, const float* l1x1_w, const float* l1x1_b, const float* cond, float* hsum,
+                 float* lin, const int num_frames)
+{
+  const float32x4_t bias_l = vld1q_f32(conv_b);
+  const float32x4_t bias_h = vld1q_f32(conv_b + 4);
+  int f = 0;
+  for (; f + 3 < num_frames; f += 4)
+  {
+    float32x4_t a0l = bias_l, a0h = bias_h, a1l = bias_l, a1h = bias_h;
+    float32x4_t a2l = bias_l, a2h = bias_h, a3l = bias_l, a3h = bias_h;
+    for (int k = 0; k < num_taps; k++)
+    {
+      const float* x = hist + static_cast<size_t>(tap_base[k] + f) * 8;
+      const float* w = conv_w + static_cast<size_t>(k) * 64;
+      const float32x4_t x0l = vld1q_f32(x), x0h = vld1q_f32(x + 4);
+      const float32x4_t x1l = vld1q_f32(x + 8), x1h = vld1q_f32(x + 12);
+      const float32x4_t x2l = vld1q_f32(x + 16), x2h = vld1q_f32(x + 20);
+      const float32x4_t x3l = vld1q_f32(x + 24), x3h = vld1q_f32(x + 28);
+      NAM_A2_COL4(w, 0, x0l, x1l, x2l, x3l, 0, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 1, x0l, x1l, x2l, x3l, 1, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 2, x0l, x1l, x2l, x3l, 2, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 3, x0l, x1l, x2l, x3l, 3, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 4, x0h, x1h, x2h, x3h, 0, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 5, x0h, x1h, x2h, x3h, 1, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 6, x0h, x1h, x2h, x3h, 2, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+      NAM_A2_COL4(w, 7, x0h, x1h, x2h, x3h, 3, a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
+    }
+    const size_t o = static_cast<size_t>(f) * 8;
+    layer8_tail(a0l, a0h, cond[f], mixin_w, l1x1_w, l1x1_b, hsum + o, lin + o);
+    layer8_tail(a1l, a1h, cond[f + 1], mixin_w, l1x1_w, l1x1_b, hsum + o + 8, lin + o + 8);
+    layer8_tail(a2l, a2h, cond[f + 2], mixin_w, l1x1_w, l1x1_b, hsum + o + 16, lin + o + 16);
+    layer8_tail(a3l, a3h, cond[f + 3], mixin_w, l1x1_w, l1x1_b, hsum + o + 24, lin + o + 24);
+  }
+  for (; f < num_frames; f++)
+  {
+    float32x4_t al = bias_l, ah = bias_h;
+    for (int k = 0; k < num_taps; k++)
+    {
+      const float* x = hist + static_cast<size_t>(tap_base[k] + f) * 8;
+      NAM_A2_GEMV8(conv_w + static_cast<size_t>(k) * 64, vld1q_f32(x), vld1q_f32(x + 4), al, ah);
+    }
+    const size_t o = static_cast<size_t>(f) * 8;
+    layer8_tail(al, ah, cond[f], mixin_w, l1x1_w, l1x1_b, hsum + o, lin + o);
+  }
 }
