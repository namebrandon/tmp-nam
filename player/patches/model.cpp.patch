+      c0h = vfmaq_laneq_f32(c0h, weights_high, input_low, 0);
+      c1l = vfmaq_laneq_f32(c1l, weights_low, input_low, 1);
+      c1h = vfmaq_laneq_f32(c1h, weights_high, input_low, 1);
+      c2l = vfmaq_laneq_f32(c2l, weights_low, input_low, 2);
+      c2h = vfmaq_laneq_f32(c2h, weights_high, input_low, 2);
+      c3l = vfmaq_laneq_f32(c3l, weights_low, input_low, 3);
+      c3h = vfmaq_laneq_f32(c3h, weights_high, input_low, 3);
+      c4l = vfmaq_laneq_f32(c4l, weights_low, input_high, 0);
+      c4h = vfmaq_laneq_f32(c4h, weights_high, input_high, 0);
+      c5l = vfmaq_laneq_f32(c5l, weights_low, input_high, 1);
+      c5h = vfmaq_laneq_f32(c5h, weights_high, input_high, 1);
+      c6l = vfmaq_laneq_f32(c6l, weights_low, input_high, 2);
+      c6h = vfmaq_laneq_f32(c6h, weights_high, input_high, 2);
+      c7l = vfmaq_laneq_f32(c7l, weights_low, input_high, 3);
+      c7h = vfmaq_laneq_f32(c7h, weights_high, input_high, 3);
+    }
+    AddDense8x8Output(output + (frame + 0) * DENSE8X8_ROWS, c0l, c0h);
+    AddDense8x8Output(output + (frame + 1) * DENSE8X8_ROWS, c1l, c1h);
+    AddDense8x8Output(output + (frame + 2) * DENSE8X8_ROWS, c2l, c2h);
+    AddDense8x8Output(output + (frame + 3) * DENSE8X8_ROWS, c3l, c3h);
+    AddDense8x8Output(output + (frame + 4) * DENSE8X8_ROWS, c4l, c4h);
+    AddDense8x8Output(output + (frame + 5) * DENSE8X8_ROWS, c5l, c5h);
+    AddDense8x8Output(output + (frame + 6) * DENSE8X8_ROWS, c6l, c6h);
+    AddDense8x8Output(output + (frame + 7) * DENSE8X8_ROWS, c7l, c7h);
+  }
+  for (; frame < frames; ++frame)
+  {
+    float32x4_t low = vdupq_n_f32(0.0f);
+    float32x4_t high = vdupq_n_f32(0.0f);
+    for (int depth = 0; depth < DENSE8X8_DEPTH; ++depth)
