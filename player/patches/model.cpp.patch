+  alignas(16) float packed[DENSE8X8_DEPTH * DENSE8X8_MAX_FRAMES];
+  if (assign)
+    std::fill(output, output + DENSE8X8_ROWS * frames, 0.0f);
+  PackDense8x8Rhs(input, frames, input_outer_stride, packed);
+  ComputeDense8x8Packed(weights, packed, frames, output);
+  return true;
+}
