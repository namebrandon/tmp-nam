+    float32x4_t c5l = vdupq_n_f32(0.0f), c5h = vdupq_n_f32(0.0f);
+    float32x4_t c6l = vdupq_n_f32(0.0f), c6h = vdupq_n_f32(0.0f);
+    float32x4_t c7l = vdupq_n_f32(0.0f), c7h = vdupq_n_f32(0.0f);
+    for (int depth = 0; depth < DENSE8X8_DEPTH; ++depth)
+    {
+      const float32x4_t weights_low = vld1q_f32(weights + depth * DENSE8X8_ROWS);
+      const float32x4_t weights_high = vld1q_f32(weights + depth * DENSE8X8_ROWS + 4);
