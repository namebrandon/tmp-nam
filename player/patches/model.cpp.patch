+
+// Pow2 ring tail mirror: cols [pow2_size, pow2_size + mbs) must equal cols
+// [0, mbs). Every column there was mirrored when last written (or is zero from
+// SetMaxBufferSize), so a block only needs to copy the columns it wrote that
+// fall inside [0, mbs). Same contents as a full refresh, without re-copying
+// mbs columns per layer per block.
+void mirror_written_cols(float* hist, int channels, int pow2_size, int mbs, int begin, int end)
+{
+  end = std::min(end, mbs);
+  if (begin < end)
+    std::memcpy(hist + static_cast<size_t>(pow2_size + begin) * channels, hist + static_cast<size_t>(begin) * channels,
+                static_cast<size_t>(end - begin) * channels * sizeof(float));
+}
+
+// Mirror both segments of a ring write of num_frames columns starting at wp.
+void mirror_ring_write(float* hist, int channels, int pow2_size, int mbs, int wp, int num_frames)
+{
+  const int first = std::min(num_frames, pow2_size - wp);
+  mirror_written_cols(hist, channels, pow2_size, mbs, wp, wp + first);
+  mirror_written_cols(hist, channels, pow2_size, mbs, 0, num_frames - first);
