+bool Dense8x8Product(const float* weights, const float* input, const int frames,
+                     const std::ptrdiff_t input_outer_stride, const std::ptrdiff_t input_inner_stride,
+                     float* output, const bool assign)
+{
+  if ((frames != 32 && frames != 34 && frames != 35) || input_inner_stride != 1
+      || input_outer_stride < DENSE8X8_DEPTH)
